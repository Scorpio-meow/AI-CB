# API 配置 - 使用本地開發環境
# REACT_APP_API_BASE=/api  # 使用相對路徑，由 proxy 處理
REACT_APP_TAGS_URL=
REACT_APP_NGROK_HEADER=false

# Webpack dev server 配置 - 本地開發
HOST=localhost
PORT=3000

# 本地 WebSocket 配置
# WDS_SOCKET_HOST=localhost
# WDS_SOCKET_PORT=3000
# WDS_SOCKET_PROTOCOL=ws
# WDS_SOCKET_PATH=/ws

# 允許所有主機連線（開發環境用）
DANGEROUSLY_DISABLE_HOST_CHECK=true
