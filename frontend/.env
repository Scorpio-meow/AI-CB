# =============================================================================
# 前端環境變數配置範本
# =============================================================================
# 注意：請複製此檔案為 .env 並填入實際的值
# 警告：前端的 .env 可能會被打包進靜態資源，不要放置敏感資訊！
# =============================================================================

# API 配置 - 使用本地開發環境
# 注意：在生產環境中，請設定正確的後端 API 地址
# REACT_APP_API_BASE=/api  # 使用相對路徑，由 proxy 處理

# Webpack dev server 配置 - 本地開發
PORT=3000

# 禁用 ESLint 以解決 ENOSPC 錯誤
DISABLE_ESLINT_PLUGIN=true

# 開發環境專用（生產環境請移除此設定）
DANGEROUSLY_DISABLE_HOST_CHECK=false

REACT_APP_MODEL_POLL_INTERVAL_MS=600000

# === 本地開發環境配置 ===
# 使用相對路徑，通過 package.json 的 proxy 轉發到後端
# REACT_APP_API_BASE=/api

# 前端 WebSocket 端點（本地開發環境）
# REACT_app_WS_URL=ws://localhost:8001/api/workflow/ws

# Webpack Dev Server WebSocket 配置 (用於 HMR 熱重載)
# 本地開發環境不需要設置 HTTPS 和特殊的 WDS_SOCKET 配置
# HTTPS=false

# === 模型列表輪詢配置 ===
# 模型列表自動更新間隔（單位：毫秒）
# 預設值: 300000 (5分鐘)
# 範例: 60000 (1分鐘), 180000 (3分鐘), 600000 (10分鐘)
# REACT_APP_MODEL_POLL_INTERVAL_MS=300000
