# =============================================================================
# 前端環境變數配置範本
# =============================================================================
# 注意：請複製此檔案為 .env 並填入實際的值
# 警告：前端的 .env 可能會被打包進靜態資源，不要放置敏感資訊！
# =============================================================================

# API 配置 - 使用本地開發環境
# 注意：在生產環境中，請設定正確的後端 API 地址
# REACT_APP_API_BASE=/api  # 使用相對路徑，由 proxy 處理

# Webpack dev server 配置 - 本地開發
PORT=3000

# 禁用 ESLint 以解決 ENOSPC 錯誤
DISABLE_ESLINT_PLUGIN=true

# 開發環境專用（生產環境請移除此設定）
DANGEROUSLY_DISABLE_HOST_CHECK=false

# === 模型列表輪詢配置 ===
# 模型列表自動更新間隔（單位：毫秒）
# 開發環境: 300000 (5分鐘) | 生產環境: 600000 (10分鐘)
REACT_APP_MODEL_POLL_INTERVAL_MS=600000

# === API 請求配置 ===
REACT_APP_API_TIMEOUT=30000        # API 請求超時（30秒）
REACT_APP_MAX_RETRIES=3            # 最大重試次數
REACT_APP_RETRY_DELAY=1000         # 重試延遲（毫秒）

# === 前端快取配置 ===
REACT_APP_ENABLE_CACHE=true        # 啟用前端快取
REACT_APP_CACHE_TTL=180000         # 前端快取 TTL（3分鐘）
REACT_APP_CACHE_MAX_SIZE=100       # 快取最大項目數

# === WebSocket 配置 ===
REACT_APP_WS_RECONNECT_INTERVAL=5000  # WebSocket 重連間隔（毫秒）
REACT_APP_WS_MAX_RECONNECT_ATTEMPTS=10 # 最大重連次數
