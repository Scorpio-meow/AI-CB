# =============================================================================
# ChatBot 應用程式環境變數配置範本
# =============================================================================
# 注意：請複製此檔案為 .env 並填入實際的值
# 警告：.env 檔案包含敏感資訊，絕對不要提交到 Git！
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Models API Configuration
# -----------------------------------------------------------------------------
MODEL_NAME=gpt-oss:20b
LLM_API_BASE=https://blowfish-absolute-absolutely.ngrok-free.app
LLM_TIMEOUT=90
MAX_CONTEXT_LENGTH=4000
QUERY_REWRITE_MODEL=phi4-mini:3.8b

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# 管理員 API Key（使用強隨機字串，至少32字符）
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=zl4DDtCi-dHRqa4-VBN_Z-bNJEVClCYWegqoLt2N098

# JWT Authentication Configuration
# JWT Secret Key（使用強隨機字串，至少64字符）
JWT_SECRET_KEY=8x5KpN2wqM_YzjTvRh9LcEu6DfXb3GsQaW1PnJmHkV7iYt0oZr4Ue-8x5KpN2wqM_YzjTvRh9LcEu6DfXb3GsQaW1PnJmHkV7
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# 開發環境使用 SQLite
DATABASE_URL=sqlite:///./chatbot.db

# 生產環境使用 PostgreSQL（範例）
# DATABASE_URL=postgresql://user:password@localhost:5432/chatbot_db

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# 本地開發環境（同時支援 localhost 和 127.0.0.1）
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8001,http://127.0.0.1:8001

# 生產環境（請替換為您的實際域名）
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# DevTunnels 支持（僅在開發環境使用）
# 如需使用 DevTunnels，請取消下面的註釋並更新為您的子域
# ALLOWED_ORIGIN_REGEX=https://[a-zA-Z0-9-]+\.asse\.devtunnels\.ms

# -----------------------------------------------------------------------------
# RAG System Configuration
# -----------------------------------------------------------------------------
# Embedding Models
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Search Parameters
SIMILARITY_THRESHOLD=0.25
TOP_K=50
RERANK_TOP_K=80
FINAL_K=10
RERANK_WEIGHT=0.8
FINAL_THRESHOLD=0.1

# Hybrid Search Configuration
HYBRID_ALPHA=0.7
NORMALIZATION=max

# Text Chunking Configuration
CHUNK_SIZE=300
CHUNK_OVERLAP=100

# Vector Store Configuration
VECTOR_STORE_TYPE=faiss

# Auto Reindexing Configuration
ENABLE_AUTO_REINDEX=0
REINDEX_HOURS=24
ENABLE_AUTO_REINDEX_TASK=1
REINDEX_INTERVAL_HOURS=24

# -----------------------------------------------------------------------------
# File Upload Configuration
# -----------------------------------------------------------------------------
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=data/uploads

# -----------------------------------------------------------------------------
# Background Tasks Configuration
# -----------------------------------------------------------------------------
UPLOADS_WATCHER_INTERVAL=30

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8001
RELOAD=true

# -----------------------------------------------------------------------------
# Workflow API Configuration
# -----------------------------------------------------------------------------
WORKFLOW_TIMEOUT=180

# -----------------------------------------------------------------------------
# Data Storage Paths
# -----------------------------------------------------------------------------
DATA_DIR=data
FAISS_INDEX_PATH=data/faiss_index.bin
DOCUMENTS_PATH=data/documents.pkl
BM25_INDEX_DIR=data/bm25_index
METADATA_PATH=data/index_metadata.pkl
WORKFLOW_OUTPUTS_DIR=data/workflow_outputs

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Development Configuration
# -----------------------------------------------------------------------------
DEBUG=true

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# === 資料庫連接池配置 ===
# 根據伺服器規格調整：小型(10/20) 中型(20/40) 大型(40/80)
DB_POOL_SIZE=20                    # 連接池大小
DB_MAX_OVERFLOW=40                 # 最大溢出連接數
DB_POOL_RECYCLE=3600               # 連接回收時間（秒）
DB_POOL_PRE_PING=true              # 連接前 ping 檢測
DB_POOL_USE_LIFO=true              # 使用 LIFO 策略減少開銷
SQLALCHEMY_ECHO=false              # SQL 查詢日誌（生產環境必須關閉）

# === RAG 系統效能 ===
TOP_K=500                           # 初始檢索數量（↓40% = +30% 速度）
RERANK_TOP_K=250                    # 重排序候選數量（↓38% = 減少計算開銷）
FINAL_K=100                          # 最終返回文檔數（更精簡的上下文）
SIMILARITY_THRESHOLD=0.3           # 相似度閾值（↑20% = 過濾噪音）

# 混合檢索權重
HYBRID_ALPHA=0.7                   # 向量檢索權重（70% 語義 + 30% 關鍵詞）
RERANK_WEIGHT=0.8                  # 重排序權重（提升相關性）
FINAL_THRESHOLD=0.15               # 最終閾值（嚴格過濾）

# 文檔分塊參數
CHUNK_SIZE=300                     # 分塊大小（↑33% = -25% 總塊數）
CHUNK_OVERLAP=100                  # 重疊大小（保持上下文連貫性）

# 索引重建（生產環境建議延長週期）
REINDEX_HOURS=48                   # 自動重建間隔（48小時降低負載）
ENABLE_AUTO_REINDEX=1              # 啟用自動重建
ENABLE_AUTO_REINDEX_TASK=1         # 啟用背景任務

# === API 快取配置 ===
CACHE_ENABLED=true                 # 啟用快取（提升 3-5x 吞吐量）
CACHE_DEFAULT_TTL=300              # 預設快取時間（5分鐘）
CACHE_STATS_TTL=180                # 統計資料快取（3分鐘，頻繁訪問）
CACHE_DOCUMENTS_TTL=600            # 文檔列表快取（10分鐘，較穩定）
CACHE_MODELS_TTL=900               # 模型列表快取（15分鐘，靜態資料）
CACHE_MAX_SIZE=1000                # 最大快取項目數

# === 前端效能配置 ===
# 這些會被前端的 .env 使用
REACT_APP_API_TIMEOUT=30000        # API 超時（毫秒）
REACT_APP_ENABLE_CACHE=true        # 啟用前端快取
REACT_APP_CACHE_TTL=180000         # 前端快取 TTL（毫秒）

# === 日誌配置 ===
LOG_LEVEL=INFO                     # 日誌級別（DEBUG/INFO/WARNING/ERROR）
LOG_SQL_QUERIES=false              # 記錄 SQL 查詢（效能影響大）

# === 並發配置 ===
# 開發環境: 1-2 workers | 生產環境: CPU核心數 * 2
UVICORN_WORKERS=4                  # Uvicorn worker 數量
UVICORN_WORKER_CLASS=uvicorn.workers.UvicornWorker
UVICORN_BACKLOG=2048               # 連接待處理佇列大小
UVICORN_KEEPALIVE_TIMEOUT=5        # Keep-alive 超時（秒）

# === 限流配置 ===
RATE_LIMIT_ENABLED=true            # 啟用限流（防止濫用）
RATE_LIMIT_PER_MINUTE=100          # 每分鐘請求限制
RATE_LIMIT_PER_HOUR=1000           # 每小時請求限制
RATE_LIMIT_BURST=20                # 突發請求緩衝
